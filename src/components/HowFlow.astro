<figure class="how-flow card mt-10 overflow-hidden" data-how-flow data-example="audio" data-route="webgpu">
  <figcaption class="how-head">
    <div>
      <p class="readout how-kicker"><span class="how-live-dot" aria-hidden="true"></span> AI model walkthrough</p>
      <h3>Audio, image, or text. A model for each.</h3>
      <p class="how-subtitle">Pick an input to see its AI model, local runtime, and output.</p>
    </div>
    <span class="how-example" data-module-path>runonweb/stt</span>
  </figcaption>

  <div class="how-stage">
    <div class="how-step how-input">
      <p class="how-step-label"><span>01</span> Choose an input</p>
      <div class="how-media-list" role="group" aria-label="Choose an input example">
        <button class="how-media" type="button" data-how-example-choice="audio" aria-pressed="true">
          <span class="how-media-icon" aria-hidden="true">▥</span>
          <span class="how-media-copy"><strong>Audio</strong><small>Microphone or file</small></span>
        </button>
        <button class="how-media" type="button" data-how-example-choice="image" aria-pressed="false">
          <span class="how-media-icon" aria-hidden="true">▧</span>
          <span class="how-media-copy"><strong>Image</strong><small>Photo or Blob</small></span>
        </button>
        <button class="how-media" type="button" data-how-example-choice="text" aria-pressed="false">
          <span class="how-media-icon how-text-icon" aria-hidden="true">T</span>
          <span class="how-media-copy"><strong>Text</strong><small>JavaScript string</small></span>
        </button>
      </div>
    </div>

    <div class="how-connector" aria-hidden="true"><span></span></div>

    <div class="how-step how-loader">
      <p class="how-step-label"><span>02</span> Load an AI model</p>
      <div class="how-code">load<span>()</span></div>
      <div class="how-model">
        <span class="how-model-caption">Model for this task</span>
        <strong data-model-name>Scribe</strong>
        <span class="how-base-model" data-base-model>Whisper tiny.en</span>
      </div>
      <p class="how-model-task" data-model-task>Transcribes speech into text.</p>
      <div class="how-step-bottom">Matching weights · cached after first load</div>
    </div>

    <div class="how-connector" aria-hidden="true"><span></span></div>

    <div class="how-step how-runtime">
      <p class="how-step-label"><span>03</span> Run locally</p>
      <p class="how-inference">The AI model runs in your browser.</p>
      <div class="how-route-options" role="group" aria-label="Preview a supported runtime">
        <button type="button" class="how-route" data-how-choice="webgpu" aria-pressed="true">
          <span class="how-route-icon" aria-hidden="true">▦</span>
          <span class="how-route-copy"><strong>WebGPU</strong><small>GPU when supported</small></span>
          <span class="how-precision" data-gpu-dtype>fp32</span>
        </button>
        <span class="how-or" aria-hidden="true">or</span>
        <button type="button" class="how-route" data-how-choice="wasm" aria-pressed="false">
          <span class="how-route-icon" aria-hidden="true">▤</span>
          <span class="how-route-copy"><strong>WASM</strong><small>Compatible CPU path</small></span>
          <span class="how-precision" data-wasm-dtype>q8</span>
        </button>
      </div>
    </div>

    <div class="how-connector" aria-hidden="true"><span></span></div>

    <div class="how-step how-output">
      <p class="how-step-label"><span>04</span> Get an output</p>
      <div class="how-output-list">
        <div class="how-output-row" data-how-output="text" data-selected>
          <span class="how-media-icon how-text-icon" aria-hidden="true">T</span>
          <span class="how-media-copy"><strong>Text</strong><small>Transcript</small></span>
        </div>
        <div class="how-output-row" data-how-output="image">
          <span class="how-media-icon" aria-hidden="true">▧</span>
          <span class="how-media-copy"><strong>Image</strong><small>Transparent PNG</small></span>
        </div>
        <div class="how-output-row" data-how-output="audio">
          <span class="how-media-icon" aria-hidden="true">▥</span>
          <span class="how-media-copy"><strong>Audio</strong><small>PCM or WAV</small></span>
        </div>
      </div>
    </div>
  </div>

  <div class="how-foot">
    <p><span class="how-foot-icon" aria-hidden="true">✓</span><strong>Real modules:</strong> Scribe uses Whisper, Remover uses BEN2, and Voice uses Kokoro.</p>
    <span class="how-foot-hint">Pick an input to trace its path</span>
  </div>
</figure>

