---
import { PAIRS } from 'runonweb/translate'
import Layout from '../../layouts/Layout.astro'
import ModelShell from '../../components/models/ModelShell.astro'
import DemoStatus from '../../components/models/DemoStatus.astro'
import Samples from '../../components/models/Samples.astro'
import Button from '../../components/ui/Button.astro'
import { getModel } from '../../data/models'
import { modelSeo } from '../../lib/seo'

const model = getModel('translate')
if (!model) throw new Error('Model translate not found')
const seo = modelSeo(model)

/**
 * Curated demo languages. Any two of them can be combined: pairs without a direct model pivot
 * through English (`es → it` loads `es-en` + `en-it`). Weights load from Hugging Face
 * (`midudev/firefox-translations`); they are ~30 MB each and exceed Cloudflare Workers' 25 MiB
 * static-asset limit, so they are not self-hosted on this site. `pnpm models:translate` is still
 * useful for local offline copies.
 */
const DEMO_LANGS = ['en', 'es', 'fr', 'de', 'it', 'pt', 'ca', 'nl', 'ja', 'zh', 'ko'].filter(
  (code) => code === 'en' || (`${code}-en` in PAIRS && `en-${code}` in PAIRS)
)

const names = new Intl.DisplayNames(['en'], { type: 'language' })
const langName = (code: string) => {
  try {
    return names.of(code) ?? code
  } catch {
    return code
  }
}
const langs = DEMO_LANGS.map((code) => ({ code, name: langName(code) }))
---

<Layout {...seo}>
  <ModelShell model={model}>
    <div slot="demo" class="space-y-5">
      <DemoStatus prefix="tr" idle="Pick two languages and a sample, or type your own" />
      <Samples prefix="tr" samples={model.samples} />
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <div class="flex flex-wrap items-center gap-2 font-mono text-[12px] text-fg-2">
          <label class="flex items-center gap-2">
            From
            <select data-tr-from class="field w-auto py-2">
              {langs.map((l) => <option value={l.code} selected={l.code === 'en'}>{l.name}</option>)}
            </select>
          </label>
          <button data-tr-swap type="button" class="field w-auto px-3 py-2" aria-label="Swap languages" title="Swap languages">⇄</button>
          <label class="flex items-center gap-2">
            To
            <select data-tr-to class="field w-auto py-2">
              {langs.map((l) => <option value={l.code} selected={l.code === 'es'}>{l.name}</option>)}
            </select>
          </label>
          <span data-tr-route class="text-fg-3"></span>
        </div>
        <label class="flex items-center gap-2 font-mono text-[12px] text-fg-2">
          <input data-tr-html type="checkbox" class="accent-accent" />
          HTML input
        </label>
        <span class="font-mono text-[12px] text-fg-3">Cached after the first load · {Object.keys(PAIRS).length} pairs in the SDK</span>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <textarea data-tr-input rows="5" class="field" placeholder="Type something to translate…">Browser-side AI keeps your data private and works offline once the model is cached.</textarea>
        <div data-tr-result class="field min-h-28 whitespace-pre-wrap text-fg-2">Translation will appear here…</div>
      </div>
      <div class="flex flex-wrap gap-2">
        <Button attr="data-tr-run" variant="primary">Translate</Button>
      </div>
    </div>
  </ModelShell>
</Layout>

<script>
  import '../../scripts/models/translate.ts'
</script>
