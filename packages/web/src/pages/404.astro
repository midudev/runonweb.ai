---
import Layout from '../layouts/Layout.astro'
import Button from '../components/ui/Button.astro'
---

<Layout
  title="Page not found"
  description="This page does not exist on runonweb."
  noindex
>
  <section class="container-x pt-16 pb-24 sm:pt-24">
    <p class="readout text-fg-3">404</p>
    <h1 class="mt-3 text-[clamp(3rem,8vw,6rem)] leading-[0.95]">Not found</h1>
    <p class="prose mt-6 max-w-lg">
      That URL is not a model, a doc, or anything else on runonweb.
    </p>
    <div class="mt-8 flex flex-wrap gap-2.5">
      <Button href="/" variant="primary">Home</Button>
      <Button href="/models">Models</Button>
      <Button href="/docs">Docs</Button>
    </div>
  </section>
</Layout>
